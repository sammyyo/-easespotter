NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Public URLs
BASE_URL=http://localhost:5000
SERVER_PUBLIC_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Session / auth
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_NAME=easespotter.sid
SESSION_COOKIE_DOMAIN=

# Frontend runtime
VITE_API_BASE_URL=http://localhost:5000
VITE_WS_BASE_URL=ws://localhost:5000

# Email
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=EaseSpotter Support
EMAIL_LOGO_URL=http://localhost:5173/favicon.png
BREVO_API_KEY=
SENDGRID_API_KEY=

# AI
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional services
FIREBASE_SERVICE_ACCOUNT_JSON=
SYNC_KEY=

# Mobile app links
# Both JVQNWKGP23 app identifiers are built in; these add extra iOS identifiers.
# Use either IOS_APP_IDS or IOS_APP_TEAM_ID + IOS_APP_BUNDLE_ID.
IOS_APP_IDS=
IOS_APP_TEAM_ID=
IOS_APP_BUNDLE_ID=

# Android App Links
# Keep the existing package during migration (default: com.samuel.easespotter).
# The verified local release certificate is built in for both packages.
# Optional comma-separated additional certificates (e.g. Play app signing).
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_CERT_FINGERPRINTS=
# Additional certificates for com.easespotter.app.
ANDROID_NEW_SHA256_CERT_FINGERPRINTS=
# Additional certificates for com.samuel.easespotter.
ANDROID_LEGACY_SHA256_CERT_FINGERPRINTS=

# Share invite fallback install buttons
IOS_APP_STORE_URL=
ANDROID_PLAY_STORE_URL=
