{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node --env-file=.env --import tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "db:push": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs push",
    "backfill:users": "node --env-file=.env --import tsx scripts/backfill-users-to-stores.ts",
    "uploads:optimize:dry-run": "node --env-file=.env --import tsx scripts/optimize-existing-uploads.ts",
    "uploads:optimize": "node --env-file=.env --import tsx scripts/optimize-existing-uploads.ts --apply --delete-originals",
    "uploads:cleanup:dry-run": "node --env-file=.env --import tsx scripts/cleanup-orphan-uploads.ts",
    "uploads:cleanup": "node --env-file=.env --import tsx scripts/cleanup-orphan-uploads.ts --delete",
    "test:mobile-links": "node --import tsx --test server/mobile-links.test.ts",
    "test:store-locations": "node --import tsx --test server/store-location.test.ts"
  },
